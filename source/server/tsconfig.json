{
    "references": [
        { "path": "../../libs" },
        { "path": "../common" }
    ],
    "compilerOptions": {
        "target": "es2017",
        "module": "commonjs",
        "sourceMap": true,
        //"strict": true,
        "jsx": "react",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        //"noUnusedLocals": true,
        "experimentalDecorators": true,
        "outDir": "../../server/bin",
        "baseUrl": "../../server/bin/node_modules"
    },
    "exclude": [
        "node_modules"
    ]
}
